# Copier ce fichier en .env.local pour travailler sur votre ordinateur.
# Sur Vercel, la variable DATABASE_URL est créée automatiquement par l'intégration Neon
# (Vercel → Storage → Neon). Ne jamais publier cette adresse : elle contient le mot de passe de la base.
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require
